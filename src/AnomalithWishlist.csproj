<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AnomalithWishlist</AssemblyName>
    <Version>1.4.5</Version>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <GameDir Condition="'$(GameDir)' == ''">$(ANOMALITH_GAME_DIR)</GameDir>
    <ManagedDir>$(GameDir)\Anomalith_Data\Managed</ManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(GameDir)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <Target Name="ValidateLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameDir)' == ''" Text="Supply -p:GameDir=YOUR_GAME_DIRECTORY or ANOMALITH_GAME_DIR. Game files are not bundled." />
    <Error Condition="!Exists('$(ManagedDir)\Assembly-CSharp.dll')" Text="Assembly-CSharp.dll not found in GameDir/Anomalith_Data/Managed. Use a lawful local game installation." />
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll') Or !Exists('$(BepInExCoreDir)\0Harmony.dll')" Text="BepInEx 5 core references not found. Install BepInEx or set -p:BepInExCoreDir=PATH_TO_CORE." />
  </Target>
  <ItemGroup>
    <Reference Include="$(ManagedDir)\UnityEngine*.dll"><Private>false</Private></Reference>
    <Reference Include="$(ManagedDir)\Unity.InputSystem.dll"><Private>false</Private></Reference>
    <Reference Include="$(ManagedDir)\Unity.TextMeshPro.dll"><Private>false</Private></Reference>
    <Reference Include="$(ManagedDir)\UnityEngine.UI.dll"><Private>false</Private></Reference>
    <Reference Include="$(ManagedDir)\Assembly-CSharp.dll"><Private>false</Private></Reference>
    <Reference Include="$(ManagedDir)\Newtonsoft.Json.dll"><Private>false</Private></Reference>
    <Reference Include="$(BepInExCoreDir)\BepInEx.dll"><Private>false</Private></Reference>
    <Reference Include="$(BepInExCoreDir)\0Harmony.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
